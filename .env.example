# Copy to .env.local and fill in. No real values belong in this file.

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Required in every environment. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Canonical public application origin, for example https://app.example.com.
# Required in production so Auth.js never derives security-sensitive links from
# an incoming Host header. No localhost or ngrok value is accepted in production.
AUTH_URL=

# Required production sign-in provider. Use separate OAuth clients for staging
# and production. Callback: https://YOUR_ORIGIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Reserved. Do not set these yet: Auth.js email sign-in requires a durable
# adapter for single-use verification tokens, which this repository does not
# implement. SMTP configuration alone is intentionally rejected in production.
EMAIL_SERVER=
EMAIL_FROM=

# ── Database ────────────────────────────────────────────────────────────────
# The application runtime connection. Must be a least-privilege role with DML
# rights on schema `app` only — never a superuser, never the Supabase
# service-role key. Use the transaction pooler (port 6543).
DATABASE_URL=

# Migrations and test setup only. Owns schema `app` and may run DDL. The
# application never reads this. Use the session pooler (port 5432).
MIGRATION_DATABASE_URL=

# ── Workflow orchestration (n8n) ────────────────────────────────────────────
# How the dashboard reaches its workflow engine. Explicit rather than inferred:
#   disabled  — no orchestration. Operations complete against the database
#               alone, and nothing claims automation that did not happen.
#   simulated — deterministic in-process engine. Development and tests only;
#               a production build refuses to start with this value.
#   live      — real HTTP to a real n8n instance.
N8N_MODE=simulated

# Required when N8N_MODE=live. The engine's base URL. Server-only: this is
# infrastructure and never reaches a browser.
N8N_BASE_URL=

# Required when N8N_MODE=live. Signs requests we send to n8n; the workflow
# verifies it. Generate with: openssl rand -hex 32
N8N_REQUEST_SIGNING_SECRET=

# Verifies requests n8n sends us. Required for the ingestion endpoint to accept
# anything at all — without it, every inbound event is refused.
N8N_WEBHOOK_SIGNING_SECRET=

# Optional. How long an outbound workflow call may take. Defaults to 10000.
N8N_TIMEOUT_MS=

# ── Provider secrets ────────────────────────────────────────────────────────
# Encrypts every stored OAuth token (AES-256-GCM). Base64 of 32 random bytes:
#   openssl rand -base64 32
# Deliberately separate from AUTH_SECRET: rotating a session secret should log
# people out, not make every calendar connection undecryptable.
CREDENTIAL_ENCRYPTION_KEY=

# ── Google Calendar ─────────────────────────────────────────────────────────
# disabled | simulated | live. A production build refuses to start on
# "simulated" — it would claim bookings reached a calendar that does not exist.
GOOGLE_CALENDAR_MODE=simulated

# Required when GOOGLE_CALENDAR_MODE=live. From a Google Cloud OAuth client.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Must match the redirect URI registered with Google exactly. Configured rather
# than derived from the request, so a Host header cannot choose where an
# authorization code is delivered.
# e.g. https://your-domain.example/api/admin/calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=

# Optional. Provider request deadline. Defaults to 10000.
GOOGLE_CALENDAR_TIMEOUT_MS=

# ── Twilio (SMS) ────────────────────────────────────────────────────────────
# disabled | simulated | live. A production build refuses to start on
# "simulated" — it would claim a customer received a text that was never sent.
TWILIO_MODE=simulated

# Required when TWILIO_MODE=live. From the Twilio console. Starts "AC".
TWILIO_ACCOUNT_SID=

# Required when TWILIO_MODE=live, and required for inbound at all: Twilio signs
# X-Twilio-Signature with the account auth token. An API key cannot verify a
# webhook, so a deployment without this can send but can never trust what it
# receives.
TWILIO_AUTH_TOKEN=

# Optional, recommended for outbound: scoped and revocable independently of the
# auth token.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# The number this deployment sends from, E.164. Which workspace a number
# belongs to is a database row (provider_phone_numbers), not this value — one
# deployment may serve many numbers.
TWILIO_PHONE_NUMBER=

# The number's resource id. Starts "PN". Optional but preferred: a number can be
# released and reassigned, and the SID is the durable identifier.
TWILIO_PHONE_NUMBER_SID=

# Optional. Send through a Messaging Service instead of a bare number.
TWILIO_MESSAGING_SERVICE_SID=

# Required when TWILIO_MODE=live. The exact public URLs Twilio posts to.
# Configured rather than derived from the request: Twilio's signature covers the
# full URL, so behind a tunnel or proxy the observed URL is not the signed one.
# Two values because two endpoints are signed separately.
#   e.g. https://your-tunnel.example/api/internal/twilio/sms
TWILIO_PUBLIC_WEBHOOK_URL=
#   e.g. https://your-tunnel.example/api/internal/twilio/status
TWILIO_STATUS_CALLBACK_URL=

# Optional. Provider request deadline. Defaults to 10000.
TWILIO_TIMEOUT_MS=
